# --- Layout ---------------------------------------------------------------
sort=-time
layer=overlay
anchor=top-right
width=360
height=150
margin=12
padding=12
border-size=2
border-radius=6
icons=1
max-icon-size=48
markup=1
actions=1
default-timeout=4000
ignore-timeout=0
font=sans 10

# --- Base (normal urgency) — Duskmire bg1/fg1/accent3 ----------------------
background-color=#15140fee
text-color=#d7cdb2
border-color=#d0be76
progress-color=over #6aa7a2

# --- Low urgency — muted, fg4/fg2, no border emphasis ----------------------
[urgency=low]
background-color=#15140fee
text-color=#aba492
border-color=#6f6c63
default-timeout=4000

# --- Normal urgency — same as base, accent3 gold border --------------------
[urgency=normal]
background-color=#15140fee
text-color=#d7cdb2
border-color=#d0be76

# --- Critical urgency — accent1/red, tinted bg_visual.red, no timeout ------
[urgency=critical]
background-color=#220d08ee
text-color=#e8866f
border-color=#c26f5c
default-timeout=0

# --- Hidden notification count grouping -------------------------------------
[mode=do-not-disturb]
invisible=1

# --- Grouped/summary notifications ------------------------------------------
[grouped]
format=(<b>%g</b>) <b>%s</b>\n%b
